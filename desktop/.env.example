# SabiLearn Desktop Environment Configuration
# Copy this file to .env.local for local development.
# In GitHub Actions, set these as repository Variables or Secrets.

# Backend API base URL (default: https://api.sabilearn.online/api/v1)
VITE_API_URL=https://api.sabilearn.online/api/v1

# Optional: Paystack public key (used only for client-side metadata if needed;
# checkout runs through /payments/*/initialize + system browser)
VITE_PAYSTACK_PUBLIC_KEY=

# Optional: Google Desktop OAuth + Firebase Web config
# Leave VITE_GOOGLE_DESKTOP_CLIENT_ID empty to hide the "Continue with Google" button.
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
