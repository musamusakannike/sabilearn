# Application Config
PORT=5000
NODE_ENV=development
CORS_ORIGIN=*
# Frontend base URL, used to build the Paystack checkout callback (e.g. https://app.sabilearn.online)
CLIENT_URL=http://localhost:3000

# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/sabilearn

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_change_me
JWT_EXPIRES_IN=7d

# Firebase Admin Configuration
# Option 1: Path to a credentials file (relative or absolute)
FIREBASE_SERVICE_ACCOUNT_PATH=
# Option 2: Inline credentials variables (useful for cloud deploys)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Cloudflare R2 / S3 Compatible API Configuration
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# Email
# Shared "from" address (used by both providers). SMTP_FROM kept for backwards compat.
EMAIL_FROM=SabiLearn <noreply@sabilearn.online>

# Email (Resend) — preferred when RESEND_API_KEY is set
RESEND_API_KEY=

# Email (SMTP) — fallback when Resend is not configured or fails
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SabiLearn <noreply@sabilearn.online>

# Push (Expo)
EXPO_ACCESS_TOKEN=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_SUBSCRIPTION_PLAN_CODE=
# Amount in kobo (e.g. 250000 = NGN 2,500.00)
SUBSCRIPTION_AMOUNT_KOBO=

# RevenueCat (mobile IAP). Secret key from the RC dashboard; webhook auth is
# the Authorization value you configure on the RC webhook.
REVENUECAT_SECRET_API_KEY=
REVENUECAT_WEBHOOK_AUTH=

# DeepSeek AI Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

