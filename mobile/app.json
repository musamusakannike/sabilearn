{
  "expo": {
    "name": "SabiLearn",
    "slug": "sabilearn",
    "version": "2.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "sabilearn",
    "userInterfaceStyle": "light",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.codiac.sabilearn",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SabiLearn uses your camera to let you take a new profile photo.",
        "NSPhotoLibraryUsageDescription": "SabiLearn uses your photo library to let you choose a profile photo."
      }
    },
    "android": {
      "package": "com.codiac.sabilearn",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#F5F3EE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F5F3EE",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#F2A900",
          "defaultChannel": "reminders"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "@react-native-firebase/app",
      "@react-native-firebase/auth",
      "@react-native-google-signin/google-signin",
      "expo-apple-authentication",
      [
        "expo-build-properties",
        {
          "ios": {
            "useFrameworks": "static"
          }
        }
      ],
      "expo-image",
      "./plugins/withFirebasePodfile"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiUrl": "https://api.sabilearn.online/api/v1",
      "revenueCatIosApiKey": "appl_OGbQqYOkkBtcJissQRMTsbSIMKf",
      "revenueCatAndroidApiKey": "goog_REPLACE_ME",
      "paystackPublicKey": "pk_live_0a6cd813f6db93dc88bd7c4657cc27ca5ba07941",
      "subscriptionAmountKobo": 300000,
      "router": {},
      "eas": {
        "projectId": "424de974-a590-4b82-90c4-c390a80163c1"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/424de974-a590-4b82-90c4-c390a80163c1"
    }
  }
}
